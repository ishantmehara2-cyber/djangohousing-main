DJANGO_ENV=development
DEBUG=True
SECRET_KEY=django-insecure-housing-clone-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (SQLite3)
DB_ENGINE=django.db.backends.sqlite3

# Email SMTP Configuration (Gmail)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-google-app-password

# Redis / Celery
REDIS_URL=redis://127.0.0.1:6379/0

# AWS S3 / Cloudflare R2 Storage (Optional)
USE_S3=False
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_STORAGE_BUCKET_NAME=your_bucket_name
AWS_S3_ENDPOINT_URL=https://your_r2_account_id.r2.cloudflarestorage.com

# SSL Redirect in Production
SECURE_SSL_REDIRECT=True
